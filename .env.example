DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/<db_name>
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT=60.0
LLM_MAX_TOKENS=1024
LLM_OPTIMIZATION_MAX_TOKENS=8192
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.65
# CORS: comma-separated exact origins (credentialed).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Regex for extra origins (e.g. the browser extension). Pin the exact
# chrome-extension://<id> origin in production instead of this dev pattern.
CORS_ORIGIN_REGEX=chrome-extension://.*
