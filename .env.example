# Database
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/prompt_enhancer
TEST_DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/prompt_enhancer_test

# JWT Auth
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email (SMTP for OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@promptenhancer.com

# OTP
OTP_EXPIRE_MINUTES=10

# File Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# App
APP_NAME=Prompt Enhancer
APP_VERSION=1.0.0
DEBUG=true
